model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Orders","Order Items","Customers","Products","Sellers","Calendar","BaseUrl"]

annotation PBI_ProTooling = ["DevMode"]

ref table Orders
ref table 'Order Items'
ref table Customers
ref table Products
ref table Sellers
ref table Calendar

ref cultureInfo en-GB

