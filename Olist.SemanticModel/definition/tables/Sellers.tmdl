/// Marketplace sellers.
table Sellers
	lineageTag: e310103d-ad92-4e44-a2a8-aab8b7d3e668

	column seller_id
		dataType: string
		isKey
		lineageTag: 16d44478-58c4-4bd1-a1db-25f3f5de0966
		summarizeBy: none
		sourceColumn: seller_id

	column state
		dataType: string
		lineageTag: e62eb715-8e70-4efa-9241-fa94b3bba8fa
		summarizeBy: none
		sourceColumn: state

	column city
		dataType: string
		lineageTag: 038a8c6a-c3ff-4427-8102-06292e8d5354
		summarizeBy: none
		sourceColumn: city

	partition Sellers = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "dim_sellers.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells arrive as "" and would fail the type change (e.g. is_late for undelivered orders): make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Blanks to Null",
				        {
				            {"seller_id", type text},
				            {"state", type text},
				            {"city", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result

