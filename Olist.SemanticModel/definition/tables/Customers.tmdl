/// One row per person (customer_unique_id), not per order.
table Customers

	column customer_unique_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: customer_unique_id

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column first_order_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: first_order_at

	column last_order_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: last_order_at

	column orders
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: orders

	column is_repeat_customer
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_repeat_customer

	partition Customers = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "dim_customers.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells arrive as "" and would fail the type change (e.g. is_late for undelivered orders): make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Blanks to Null",
				        {
				            {"customer_unique_id", type text},
				            {"state", type text},
				            {"city", type text},
				            {"first_order_at", type datetime},
				            {"last_order_at", type datetime},
				            {"orders", Int64.Type},
				            {"is_repeat_customer", type logical}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

