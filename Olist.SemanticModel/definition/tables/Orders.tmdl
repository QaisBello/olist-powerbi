	column items
		dataType: int64
		formatString: 0
		lineageTag: 830c2377-5faa-4279-ad75-bc49f519a7d2
		summarizeBy: none
		sourceColumn: items

	column sellers
		dataType: int64
		formatString: 0
		lineageTag: bd28363c-17b2-4eb9-9a6d-6ea04375024d
		summarizeBy: none
		sourceColumn: sellers

	column items_value
		dataType: decimal
		formatString: #,0.00
		lineageTag: cb0347b0-5c85-4860-b8c3-9e053ede1eab
		summarizeBy: none
		sourceColumn: items_value

	column freight_value
		dataType: decimal
		formatString: #,0.00
		lineageTag: 1797462d-8301-47a6-b015-817530389889
		summarizeBy: none
		sourceColumn: freight_value

	column order_value
