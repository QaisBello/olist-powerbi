/// One row per order (dbt model fct_orders), January 2017 to August 2018.
table Orders

	/// Orders placed.
	measure 'Order Count' = COUNTROWS ( Orders )
		formatString: #,0
		displayFolder: Sales

	/// Value of goods sold, excluding freight (Brazilian reais).
	measure Revenue = SUM ( 'Order Items'[price] )
		formatString: "R$"#,0
		displayFolder: Sales

	/// Freight charged to customers.
	measure Freight = SUM ( 'Order Items'[freight_value] )
		formatString: "R$"#,0
		displayFolder: Sales

	/// Revenue per order.
	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Order Count] )
		formatString: "R$"#,0.00
		displayFolder: Sales

	/// Distinct people who ordered.
	measure 'Customer Count' = DISTINCTCOUNT ( Orders[customer_unique_id] )
		formatString: #,0
		displayFolder: Sales

	/// Revenue in the same period a year earlier.
	measure 'Revenue LY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[date_day] ) )
		formatString: "R$"#,0
		displayFolder: Sales

	/// Change in revenue against the same period a year earlier.
	measure 'Revenue YoY %' =
			VAR _ly = [Revenue LY]
			RETURN
			    IF ( NOT ISBLANK ( _ly ), DIVIDE ( [Revenue] - _ly, _ly ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales

	/// Cumulative revenue up to the latest date in context.
	measure 'Revenue Running Total' =
			CALCULATE (
			    [Revenue],
			    FILTER ( ALL ( 'Calendar'[date_day] ), 'Calendar'[date_day] <= MAX ( 'Calendar'[date_day] ) )
			)
		formatString: "R$"#,0
		displayFolder: Sales

	/// Orders delivered, with a delivery date recorded.
	measure 'Delivered Orders' =
			CALCULATE (
			    COUNTROWS ( Orders ),
			    Orders[order_status] = "delivered",
			    NOT ISBLANK ( Orders[delivered_at] )
			)
		formatString: #,0
		displayFolder: Delivery

	/// Delivered after the date promised at checkout.
	measure 'Late Orders' = CALCULATE ( [Delivered Orders], Orders[is_late] == TRUE () )
		formatString: #,0
		displayFolder: Delivery

	/// Share of delivered orders that arrived late.
	measure '% Late' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%
		displayFolder: Delivery

	/// Days from purchase to delivery.
	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( Orders[delivery_days] ), Orders[order_status] = "delivered" )
		formatString: 0.0
		displayFolder: Delivery

	/// Average review score, 1 to 5.
	measure 'Avg Review' = AVERAGE ( Orders[review_score] )
		formatString: 0.00
		displayFolder: Reviews

	/// Average review for orders delivered on or before the promised date.
	measure 'Avg Review (On Time)' = CALCULATE ( [Avg Review], Orders[is_late] == FALSE () )
		formatString: 0.00
		displayFolder: Reviews

	/// Average review for orders delivered late.
	measure 'Avg Review (Late)' = CALCULATE ( [Avg Review], Orders[is_late] == TRUE () )
		formatString: 0.00
		displayFolder: Reviews

	/// How many stars a late delivery costs.
	measure 'Review Gap' = [Avg Review (On Time)] - [Avg Review (Late)]
		formatString: 0.00
		displayFolder: Reviews

	/// Share of reviewed orders rated one star.
	measure '% One-Star' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Orders ), Orders[review_score] = 1 ),
			    CALCULATE ( COUNTROWS ( Orders ), NOT ISBLANK ( Orders[review_score] ) )
			)
		formatString: 0.0%
		displayFolder: Reviews

	/// Share of customers who ordered more than once.
	measure 'Repeat Customer %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Customers ), Customers[is_repeat_customer] == TRUE () ),
			    COUNTROWS ( Customers )
			)
		formatString: 0.0%
		displayFolder: Customers

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column customer_unique_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_unique_id

	column customer_state
		dataType: string
		summarizeBy: none
		sourceColumn: customer_state

	column order_status
		dataType: string
		summarizeBy: none
		sourceColumn: order_status

	column purchased_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: purchased_at

	column purchase_date
		dataType: dateTime
		isHidden
		formatString: Short Date
		summarizeBy: none
		sourceColumn: purchase_date

	column items
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: items

	column sellers
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: sellers

	column items_value
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: items_value

	column freight_value
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: freight_value

	column order_value
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: order_value

	column payment_value
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: payment_value

	column payment_type
		dataType: string
		summarizeBy: none
		sourceColumn: payment_type

	column installments
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: installments

	column used_voucher
		dataType: boolean
		summarizeBy: none
		sourceColumn: used_voucher

	column payment_mismatch
		dataType: boolean
		summarizeBy: none
		sourceColumn: payment_mismatch

	column delivered_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: delivered_at

	column estimated_delivery_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: estimated_delivery_date

	column delivery_days
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: delivery_days

	column days_late
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: days_late

	column is_late
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_late

	column review_score
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: review_score

	column has_comment
		dataType: boolean
		summarizeBy: none
		sourceColumn: has_comment

	column in_analysis_window
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: in_analysis_window

	column Lateness
		dataType: string
		summarizeBy: none
		sourceColumn: Lateness
		sortByColumn: 'Lateness Order'

	column 'Lateness Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Lateness Order

	partition Orders = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "fct_orders.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Promoted Headers",
				        {
				            {"order_id", type text},
				            {"customer_unique_id", type text},
				            {"customer_state", type text},
				            {"order_status", type text},
				            {"purchased_at", type datetime},
				            {"purchase_date", type datetime},
				            {"items", Int64.Type},
				            {"sellers", Int64.Type},
				            {"items_value", Currency.Type},
				            {"freight_value", Currency.Type},
				            {"order_value", Currency.Type},
				            {"payment_value", Currency.Type},
				            {"payment_type", type text},
				            {"installments", Int64.Type},
				            {"used_voucher", type logical},
				            {"payment_mismatch", type logical},
				            {"delivered_at", type datetime},
				            {"estimated_delivery_date", type datetime},
				            {"delivery_days", Int64.Type},
				            {"days_late", Int64.Type},
				            {"is_late", type logical},
				            {"review_score", Int64.Type},
				            {"has_comment", type logical},
				            {"in_analysis_window", type logical}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Types", each [in_analysis_window] = true),
				    #"Lateness Order" = Table.AddColumn(#"Filtered Rows", "Lateness Order", each
				        if [days_late] = null then null
				        else if [days_late] <= -15 then 1 else if [days_late] <= -8 then 2 else if [days_late] <= -1 then 3
				        else if [days_late] = 0 then 4 else if [days_late] <= 3 then 5 else if [days_late] <= 7 then 6
				        else if [days_late] <= 14 then 7 else 8, Int64.Type),
				    #"Lateness" = Table.AddColumn(#"Lateness Order", "Lateness", each
				        {null, "15+ days early", "8-14 days early", "1-7 days early", "On the day",
				         "1-3 days late", "4-7 days late", "8-14 days late", "15+ days late"}{if [Lateness Order] = null then 0 else [Lateness Order]}, type text),
				    Result = #"Lateness"
				in
				    Result
				```

