		sortByColumn: 'Lateness Order'

	column 'Lateness Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5779d655-bb0d-40b1-8890-8d701c50f954
		summarizeBy: none
		sourceColumn: Lateness Order

	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "fct_orders.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells arrive as "" and would fail the type change (e.g. is_late for undelivered orders): make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Blanks to Null",
				        {
				            {"order_id", type text},
				            {"customer_unique_id", type text},
				            {"customer_state", type text},
				            {"order_status", type text},
				            {"purchased_at", type datetime},
				            {"purchase_date", type datetime},
				            {"items", Int64.Type},
				            {"sellers", Int64.Type},
				            {"items_value", Currency.Type},
				            {"freight_value", Currency.Type},
				            {"order_value", Currency.Type},
				            {"payment_value", Currency.Type},
				            {"payment_type", type text},
				            {"installments", Int64.Type},
				            {"used_voucher", type logical},
				            {"payment_mismatch", type logical},
				            {"delivered_at", type datetime},
				            {"estimated_delivery_date", type datetime},
				            {"delivery_days", Int64.Type},
				            {"days_late", Int64.Type},
				            {"is_late", type logical},
				            {"review_score", Int64.Type},
				            {"has_comment", type logical},
				            {"in_analysis_window", type logical}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Types", each [in_analysis_window] = true),
				    #"Lateness Order" = Table.AddColumn(#"Filtered Rows", "Lateness Order", each
				        if [days_late] = null then null
				        else if [days_late] <= -15 then 1 else if [days_late] <= -8 then 2 else if [days_late] <= -1 then 3
				        else if [days_late] = 0 then 4 else if [days_late] <= 3 then 5 else if [days_late] <= 7 then 6
				        else if [days_late] <= 14 then 7 else 8, Int64.Type),
				    #"Lateness" = Table.AddColumn(#"Lateness Order", "Lateness", each
				        {null, "15+ days early", "8-14 days early", "1-7 days early", "On the day",
				         "1-3 days late", "4-7 days late", "8-14 days late", "15+ days late"}{if [Lateness Order] = null then 0 else [Lateness Order]}, type text),
				    Result = #"Lateness"
				in
				    Result

