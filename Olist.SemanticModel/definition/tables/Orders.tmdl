/// One row per order (dbt model fct_orders), January 2017 to August 2018.
table Orders
	lineageTag: 894f0a88-dc9a-4720-af33-8bf4d0c15080

	/// Orders placed.
	measure 'Order Count' = COUNTROWS ( Orders )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 1ea39d6f-8282-4ecd-aeda-8b87d5f68fbd

	/// Value of goods sold, excluding freight (Brazilian reais).
	measure Revenue = SUM ( 'Order Items'[price] )
		formatString: R\$#,0
		displayFolder: Sales
		lineageTag: f3b321f2-5576-48d8-8614-6e99beec2711

	/// Freight charged to customers.
	measure Freight = SUM ( 'Order Items'[freight_value] )
		formatString: R\$#,0
		displayFolder: Sales
		lineageTag: a9b18140-c2a3-4af7-9dad-57d3c5776cd6

	/// Revenue per order.
	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Order Count] )
		formatString: R\$#,0.00
		displayFolder: Sales
		lineageTag: 26407996-1f70-4f81-9b82-7f1e12870b80

	/// Distinct people who ordered.
	measure 'Customer Count' = DISTINCTCOUNT ( Orders[customer_unique_id] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 677d401a-73c8-4b6f-bf16-d7722db20d81

	/// Revenue in the same period a year earlier.
	measure 'Revenue LY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[date_day] ) )
		formatString: R\$#,0
		displayFolder: Sales
		lineageTag: ec054d99-c0bd-4161-9a34-b784db0c32c6

	/// Change in revenue against the same period a year earlier.
	measure 'Revenue YoY %' =
			VAR _ly = [Revenue LY]
			RETURN
			    IF ( NOT ISBLANK ( _ly ), DIVIDE ( [Revenue] - _ly, _ly ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales
		lineageTag: 33b159ec-e04d-4441-b47a-f9b9847c63b5

	/// Cumulative revenue up to the latest date in context.
	measure 'Revenue Running Total' =
			CALCULATE (
			    [Revenue],
			    FILTER ( ALL ( 'Calendar'[date_day] ), 'Calendar'[date_day] <= MAX ( 'Calendar'[date_day] ) )
			)
		formatString: R\$#,0
		displayFolder: Sales
		lineageTag: 3885846a-ae30-416a-9a41-b92968779b66

	/// Orders delivered, with a delivery date recorded.
	measure 'Delivered Orders' =
			CALCULATE (
			    COUNTROWS ( Orders ),
			    Orders[order_status] = "delivered",
			    NOT ISBLANK ( Orders[delivered_at] )
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 3803d4c1-20d0-4489-90b4-85c26519ac24

	/// Delivered after the date promised at checkout.
	measure 'Late Orders' = CALCULATE ( [Delivered Orders], Orders[is_late] == TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 1ee97c82-9ca3-4d5d-8070-566ad36660f4

	/// Share of delivered orders that arrived late.
	measure '% Late' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 8e2f538e-8e55-4b09-979b-f254115f1018

	/// Days from purchase to delivery.
	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( Orders[delivery_days] ), Orders[order_status] = "delivered" )
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: c9d3d984-c710-421d-830c-378c4112f566

	/// Average review score, 1 to 5.
	measure 'Avg Review' = AVERAGE ( Orders[review_score] )
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: e117b309-2fe6-4840-b25e-6702b03f2f1d

	/// Average review for orders delivered on or before the promised date.
	measure 'Avg Review (On Time)' = CALCULATE ( [Avg Review], Orders[is_late] == FALSE () )
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: 1ce53e71-7615-411f-9bbd-c95701bfb93c

	/// Average review for orders delivered late.
	measure 'Avg Review (Late)' = CALCULATE ( [Avg Review], Orders[is_late] == TRUE () )
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: 8032d3fd-8f67-438d-b8eb-c7aa70be5cbe

	/// How many stars a late delivery costs.
	measure 'Review Gap' = [Avg Review (On Time)] - [Avg Review (Late)]
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: c72789fc-7904-4639-9997-75ec31e7f3ab

	/// Share of reviewed orders rated one star.
	measure '% One-Star' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Orders ), Orders[review_score] = 1 ),
			    CALCULATE ( COUNTROWS ( Orders ), NOT ISBLANK ( Orders[review_score] ) )
			)
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: 50c2c34e-6c3d-4940-9e4f-d9894bdee7fc

	/// Share of customers who ordered more than once.
	measure 'Repeat Customer %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Customers ), Customers[is_repeat_customer] == TRUE () ),
			    COUNTROWS ( Customers )
			)
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 56178f64-bae8-4691-a91f-d05d3e768e70

	/// Average review for delivered orders only. KEEPFILTERS keeps the chart's own Lateness filter, so the blank (not delivered) band returns BLANK and drops out.
	measure 'Avg Review (Delivered)' = CALCULATE ( [Avg Review], KEEPFILTERS ( NOT ISBLANK ( Orders[Lateness] ) ) )
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: 8d6f442c-2163-4e45-a3e0-3dd0ef5fa589

	column order_id
		dataType: string
		lineageTag: 121a5880-7bb9-4a18-9ffa-79292fa24c53
		summarizeBy: none
		sourceColumn: order_id

	column customer_unique_id
		dataType: string
		isHidden
		lineageTag: a5968965-f38b-4170-9369-fc3861ca0e52
		summarizeBy: none
		sourceColumn: customer_unique_id

	column customer_state
		dataType: string
		lineageTag: 68a21a90-0fbc-4997-b554-1e99ff314146
