 "measures": [
  {
   "name": "Order Count",
   "folder": "Sales",
   "format": "#,0",
   "dax": "COUNTROWS ( Orders )",
   "description": "Orders placed."
  },
  {
   "name": "Revenue",
   "folder": "Sales",
   "format": "R\\$#,0",
   "dax": "SUM ( 'Order Items'[price] )",
   "description": "Value of goods sold, excluding freight (Brazilian reais)."
  },
  {
   "name": "Freight",
   "folder": "Sales",
   "format": "R\\$#,0",
   "dax": "SUM ( 'Order Items'[freight_value] )",
   "description": "Freight charged to customers."
  },
  {
   "name": "Avg Order Value",
   "folder": "Sales",
   "format": "R\\$#,0.00",
   "dax": "DIVIDE ( [Revenue], [Order Count] )",
   "description": "Revenue per order."
  },
  {
   "name": "Customer Count",
   "folder": "Sales",
   "format": "#,0",
   "dax": "DISTINCTCOUNT ( Orders[customer_unique_id] )",
   "description": "Distinct people who ordered."
  },
  {
   "name": "Revenue LY",
   "folder": "Sales",
   "format": "R\\$#,0",
   "dax": "CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[date_day] ) )",
   "description": "Revenue in the same period a year earlier."
  },
  {
   "name": "Revenue YoY %",
   "folder": "Sales",
   "format": "0.0%;-0.0%;0.0%",
   "dax": "VAR _ly = [Revenue LY]\nRETURN\n    IF ( NOT ISBLANK ( _ly ), DIVIDE ( [Revenue] - _ly, _ly ) )",
   "description": "Change in revenue against the same period a year earlier."
  },
  {
   "name": "Revenue Running Total",
   "folder": "Sales",
   "format": "R\\$#,0",
   "dax": "CALCULATE (\n    [Revenue],\n    FILTER ( ALL ( 'Calendar'[date_day] ), 'Calendar'[date_day] <= MAX ( 'Calendar'[date_day] ) )\n)",
   "description": "Cumulative revenue up to the latest date in context."
  },
  {
   "name": "Delivered Orders",
   "folder": "Delivery",
   "format": "#,0",
   "dax": "CALCULATE (\n    COUNTROWS ( Orders ),\n    Orders[order_status] = \"delivered\",\n    NOT ISBLANK ( Orders[delivered_at] )\n)",
   "description": "Orders delivered, with a delivery date recorded."
  },
  {
   "name": "Late Orders",
   "folder": "Delivery",
   "format": "#,0",
   "dax": "CALCULATE ( [Delivered Orders], Orders[is_late] == TRUE () )",
   "description": "Delivered after the date promised at checkout."
  },
  {
   "name": "% Late",
   "folder": "Delivery",
   "format": "0.0%",
   "dax": "DIVIDE ( [Late Orders], [Delivered Orders] )",
   "description": "Share of delivered orders that arrived late."
  },
  {
   "name": "Avg Delivery Days",
   "folder": "Delivery",
   "format": "0.0",
   "dax": "CALCULATE ( AVERAGE ( Orders[delivery_days] ), Orders[order_status] = \"delivered\" )",
   "description": "Days from purchase to delivery."
  },
  {
   "name": "Avg Review",
   "folder": "Reviews",
   "format": "0.00",
   "dax": "AVERAGE ( Orders[review_score] )",
   "description": "Average review score, 1 to 5."
  },
  {
   "name": "Avg Review (Delivered)",
   "folder": "Reviews",
   "format": "0.00",
   "dax": "CALCULATE ( [Avg Review], KEEPFILTERS ( NOT ISBLANK ( Orders[Lateness] ) ) )",
   "description": "Average review for delivered orders only. KEEPFILTERS keeps the chart's own Lateness filter, so the blank (not delivered) band returns BLANK and drops out."
  },
  {
   "name": "Avg Review (On Time)",
   "folder": "Reviews",
   "format": "0.00",
   "dax": "CALCULATE ( [Avg Review], Orders[is_late] == FALSE () )",
   "description": "Average review for orders delivered on or before the promised date."
  },
  {
   "name": "Avg Review (Late)",
   "folder": "Reviews",
   "format": "0.00",
   "dax": "CALCULATE ( [Avg Review], Orders[is_late] == TRUE () )",
   "description": "Average review for orders delivered late."
  },
  {
   "name": "Review Gap",
   "folder": "Reviews",
   "format": "0.00",
   "dax": "[Avg Review (On Time)] - [Avg Review (Late)]",
   "description": "How many stars a late delivery costs."
  },
  {
   "name": "% One-Star",
   "folder": "Reviews",
   "format": "0.0%",
   "dax": "DIVIDE (\n    CALCULATE ( COUNTROWS ( Orders ), Orders[review_score] = 1 ),\n    CALCULATE ( COUNTROWS ( Orders ), NOT ISBLANK ( Orders[review_score] ) )\n)",
   "description": "Share of reviewed orders rated one star."
  },
  {
   "name": "Repeat Customer %",
   "folder": "Customers",
   "format": "0.0%",
   "dax": "DIVIDE (\n    CALCULATE ( COUNTROWS ( Customers ), Customers[is_repeat_customer] == TRUE () ),\n    COUNTROWS ( Customers )\n)",
   "description": "Share of customers who ordered more than once."
  }
 ],
